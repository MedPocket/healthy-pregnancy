---
import Icon from "blume/components/Icon.astro";
---

<footer
  class="border-t border-border py-6 text-center text-sm text-muted-foreground"
>
  <div
    class="mx-auto flex max-w-content items-center justify-center gap-1 px-4"
  >
    <span>made with</span>
    <Icon
      name="heart"
      class="fill-red-500 stroke-red-500 text-red-500"
      size={16}
      label="love"
    />
    <span>by MedPocket</span>
    <Icon
      name="delta"
      class="fill-teal-500 stroke-teal-500 text-teal-500"
      size={16}
      label="delta"
    />
    <span>founder by Long Nhat Nguyen</span>
  </div>
</footer>
