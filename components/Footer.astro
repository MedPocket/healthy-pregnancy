---
import Icon from "blume/components/Icon.astro";
---

<footer class="border-t border-border py-6 text-sm text-muted-foreground">
  <div
    class="mx-auto flex max-w-content flex-wrap items-center justify-center gap-x-2 gap-y-1 px-4 text-center leading-normal"
  >
    <div class="inline-flex items-center gap-1.5">
      <span>made with</span>
      <Icon
        name="heart"
        class="inline-block fill-red-500 stroke-red-500 text-red-500"
        size={16}
        label="love"
      />
      <span>by</span>
      <span class="font-medium text-foreground">MedPocket</span>
    </div>
    <Icon
      name="delta"
      class="inline-block fill-teal-500 stroke-teal-500 text-teal-500"
      size={16}
      label="delta"
    />
    <div class="inline-flex items-center gap-1.5">
      <span>founder by</span>
      <span class="font-medium text-foreground">Long Nhat Nguyen</span>
    </div>
  </div>
</footer>
